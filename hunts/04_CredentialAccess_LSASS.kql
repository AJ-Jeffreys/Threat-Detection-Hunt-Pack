// Detection: Suspicious LSASS Memory Access
// Author: AJ Jeffreys
// MITRE: T1003.001
// Tactic: Credential Access
// Source: DeviceEvents
// Severity: Critical
// Status: Analytic
// Notes: Flags processes opening LSASS from unexpected callers. Covers Mimikatz,
//        ProcDump abuse, and Cobalt Strike credential extraction. In healthcare,
//        stolen credentials are the primary path to EHR systems and domain controllers.
//        Requires DeviceEvents with OpenProcessApiCall action type enabled in Defender.

let AllowedCallers = dynamic([
    "MsMpEng.exe","svchost.exe","csrss.exe","wininit.exe",
    "services.exe","lsass.exe","winlogon.exe","taskmgr.exe"
]);
// Replace AllowList with privileged admin account names in your environment
let AllowList = dynamic(["replace-with-admin1","replace-with-admin2"]);

DeviceEvents
| where Timestamp > ago(7d)
| where ActionType == "OpenProcessApiCall"
| where FileName =~ "lsass.exe"                         // target process = LSASS
| where not(InitiatingProcessFileName in~ (AllowedCallers)) // caller not in expected list
| where not(InitiatingProcessAccountName in~ (AllowList))
| project
    Timestamp, DeviceName, AccountName,
    InitiatingProcessFileName, InitiatingProcessId,
    InitiatingProcessCommandLine, InitiatingProcessAccountName,
    AdditionalFields
| order by Timestamp desc
